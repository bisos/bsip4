def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*Code Execution Examples*')
    if not (resStr := b.subProc.Op(outcome=cmndOutcome, log=0).bash(
       f"""which code""").stdout):  return(b_io.eh.badOutcome(cmndOutcome))

    literal(f"which code# {resStr.strip()}")
    literal("code --version")
    literal("code --help")
    literal("alias vscode='code --no-sandbox --disable-gpu --user-data-dir=/tmp/vscode-root'")

    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Local VS Code Extensions (run as the VS Code user, not root)*')
    cmnd('extsReport', comment=" # Listed extensions: pinned and installed versions")
    cmnd('extsInstallPinned', comment=" # Install at the pinned versions")
    cmnd('extsInstallLatest', comment=" # Install, or upgrade, to the latest versions")
    literal("code --list-extensions --show-versions")

    cs.examples.menuChapter('*End-Of Examples*')
    return cmndOutcome
