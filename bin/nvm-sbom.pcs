from bisos import b
# from bisos.b import cmndsSeed
from bisos.b import cs
from bisos.b import b_io

# import collections
import typing

from bisos.sbom import pkgsSeed  # pkgsSeed.plantWithWhich("seedSbom.cs")
ap = pkgsSeed.aptPkg


def nvmInstall():
    """Install nvm (Node Version Manager) for the current user via the official install script.
    Source: https://github.com/nvm-sh/nvm
    NB: runs as the invoking user (not root) -- nvm lives in ~/.nvm.
    The install script appends activation lines to ~/.bashrc automatically.
    """
    outcome = b.subProc.WOpW(invedBy=None, log=1).bash(
        """
NVM_VERSION="v0.40.3"
curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh" | bash
""")


aptPkgsList = [
    ap("curl"),                        # Required by the nvm install script
    ap("nvm", func=nvmInstall),        # nvm -- Node Version Manager, installed per-user into ~/.nvm
]

pkgsSeed.setup(
    aptPkgsList=aptPkgsList,
)


####+BEGIN: b:py3:cs:cmnd/classHead :cmndName "readme" :extent "verify" :comment "Describe" :parsMand "" :parsOpt "" :argsMin 0 :argsMax 0 :pyInv ""
""" #+begin_org
*  _[[elisp:(blee:menu-sel:outline:popupMenu)][±]]_ _[[elisp:(blee:menu-sel:navigation:popupMenu)][Ξ]]_ [[elisp:(outline-show-branches+toggle)][|=]] [[elisp:(bx:orgm:indirectBufOther)][|>]] *[[elisp:(blee:ppmm:org-mode-toggle)][|N]]*  CmndSvc-   [[elisp:(outline-show-subtree+toggle)][||]] <<readme>>  *Describe*  =verify= ro=cli   [[elisp:(org-cycle)][| ]]
#+end_org """
class readme(cs.Cmnd):
    cmndParamsMandatory = [ ]
    cmndParamsOptional = [ ]
    cmndArgsLen = {'Min': 0, 'Max': 0,}

    @cs.track(fnLoc=True, fnEntry=True, fnExit=True)
    def cmnd(self,
             rtInv: cs.RtInvoker,
             cmndOutcome: b.op.Outcome,
    ) -> b.op.Outcome:
        """Describe"""
        failed = b_io.eh.badOutcome
        callParamsDict = {}
        if self.invocationValidate(rtInv, cmndOutcome, callParamsDict, None).isProblematic():
            return failed(cmndOutcome)
####+END:
        descriptionStr = """** Scope: nvm (Node Version Manager) for Debian 12.

** What this installs:

  nvm (https://github.com/nvm-sh/nvm) -- the standard per-user Node.js
  version manager. Installed via the official install script into ~/.nvm.

** Important: nvm is per-user, NOT system-wide.
  Run this sbom as the target user (not root).
  The install script adds activation lines to ~/.bashrc automatically.
  To activate nvm in the current shell without restarting:
      export NVM_DIR="$HOME/.nvm"
      [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"

** After installing nvm, install a Node.js version:
      nvm install --lts        # latest LTS (recommended)
      nvm install 22           # specific major version
      nvm use --lts            # activate LTS in current shell
      nvm alias default lts/*  # set default for new shells

** Update nvm itself:
      nvm-sbom.pcs -i sbom_fullUpdate   # re-runs install script (idempotent)
"""
        print(descriptionStr)

        return cmndOutcome.set(
            opError=b.op.OpError.Success,
            opResults=None,
        )

def examples_csu() -> b.op.Outcome:
    """Common Usage Examples for this Command-Service Unit"""

    cmnd = cs.examples.cmndEnter
    literal = cs.examples.execInsert

    cmndOutcome = b.op.Outcome()

    cs.examples.menuChapter('*nvm Install*')
    literal("nvm-sbom.pcs -i sbom_fullUpdate   # install/update nvm (run as target user, not root)")

    cmnd('readme', comment=" # An overview short description")

    cs.examples.menuChapter('*Activate nvm in current shell*')
    literal('export NVM_DIR="$HOME/.nvm"')
    literal('[ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh"')

    cs.examples.menuChapter('*Install and select Node.js versions*')
    literal("nvm install --lts        # install latest LTS")
    literal("nvm install 22           # install Node 22")
    literal("nvm use --lts            # use LTS in this shell")
    literal("nvm alias default lts/*  # set default for new shells")
    literal("nvm ls                   # list installed versions")
    literal("nvm ls-remote            # list all available versions")

    cs.examples.menuChapter('*Verify*')
    literal("nvm --version")
    literal("node --version")
    literal("npm --version")
    literal("which node")

    cs.examples.menuChapter('*End-Of  nvm Examples*')
    return cmndOutcome
